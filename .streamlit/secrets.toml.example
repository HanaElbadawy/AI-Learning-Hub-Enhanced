# ده مثال بس لشكل الإعدادات اللي هتحطيها في "Secrets" وانتي بترفعي المشروع
# على Streamlit Community Cloud (Settings → Secrets جوه لوحة تحكم الأب).
#
# محليًا مش محتاجة الملف ده خالص — .env كافي وشغال زي ما هو.
# لو عايزة تجربيه محليًا: انسخيه لـ .streamlit/secrets.toml (الملف ده
# متجاهل من git تلقائيًا) واملأي القيم الحقيقية.

MODEL_PROVIDER = "gemini"
GEMINI_API_KEY = "AIzaSy..."
GEMINI_MODEL = "gemini-flash-latest"

# لو هتستخدمي OpenAI بدل:
# MODEL_PROVIDER = "openai"
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
