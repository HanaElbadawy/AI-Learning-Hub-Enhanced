# انسخ الملف ده وسمّيه .env واملأ القيم بتاعتك
# لازم .env يفضل مش متضاف على git (متضاف في .gitignore)

# AI Model Provider
# اختار "openai" أو "gemini". Gemini مجاني بالكامل من غير بطاقة ائتمان،
# خد المفتاح من https://aistudio.google.com/apikey
MODEL_PROVIDER=gemini

# OpenAI (لو MODEL_PROVIDER=openai)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Gemini (لو MODEL_PROVIDER=gemini) — مجاني، من غير بطاقة ائتمان
# ملاحظة: أسامي الموديلات بتتغيّر بمرور الوقت. gemini-flash-latest
# بيتأكد إنه دايمًا بيشاور على أحدث نسخة flash متاحة.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-latest

# Embedding model (Sentence-Transformers، محلي مجاني)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chroma
CHROMA_PERSIST_DIR=vector_store/chroma_db
CHROMA_COLLECTION_NAME=langchain_docs

# Data collection
# المصادر بتتحدد من ملف sources.json (مش من هنا). كل مصدر فيه
# name, start_url, allowed_path_prefix, max_pages. أضف/شيل مواقع من
# sources.json مباشرة، مش محتاج تغيّر حاجة هنا عادةً.
SOURCES_CONFIG_FILE=sources.json

# Retrieval
TOP_K=5
HYBRID_ALPHA=0.8
